    <div class="contact-actions">
      <a class="button" href="tel:+918016137886">CALL 8016137886</a>

      <a
        class="button outline"
        href="https://wa.me/918016137886?text=Assalamu%20alaikum%2C%20I%20want%20to%20enquire%20about%20decoration."
        target="_blank"
