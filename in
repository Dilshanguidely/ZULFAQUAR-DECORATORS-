    <div class="grid" id="photoGrid"></div>
  </section>

  <section class="owner" id="owner">
    <img
      src="Owner.jpg"
      alt="Owner of Zulfaquar Decorators"
      loading="lazy"
      onerror="this.alt='Owner photo not found. Check Owner.jpg filename.'"
    >

