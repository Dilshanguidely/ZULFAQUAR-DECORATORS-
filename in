<body>

<header>
  <a class="brand" href="#home">
    ZULFAQUAR DECORATORS
    <span>EVENTS • DECOR • CELEBRATIONS</span>
  </a>

  <nav aria-label="Main navigation">
    <a href="#home">Home</a>
    <a href="#gallery">Gallery</a>
    <a href="#owner">About</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<main>
  <section class="hero" id="home">
    <div class="eyebrow">Every celebration deserves beauty</div>
    <h1>Moments made<br><em>memorable.</em></h1>

    <p>
      Discover decoration ideas for weddings, celebrations
      and special occasions — crafted with care in Islampur.
    </p>

    <a class="button" href="#gallery">EXPLORE OUR DECORATIONS ↓</a>
  </section>

  <section class="intro">
    <div class="eyebrow">Welcome to our world</div>
    <h2>Decor that tells your story.</h2>
    <p>
      From elegant stages to beautiful event setups,
      explore our work and find inspiration for your next celebration.
    </p>
  </section>

  <section class="gallery" id="gallery">
    <div class="section-heading">
      <div class="eyebrow">Our portfolio</div>
      <h2>Decoration Gallery</h2>
      <p>Tap any photo to view it in full screen.</p>
    </div>

    <div class="filters" aria-label="Filter gallery">
      <button class="filter active" data-filter="all">All Designs</button>
      <button class="filter" data-filter="stage">Stage & Wedding</button>
      <button class="filter" data-filter="event">Events</button>
      <button class="filter" data-filter="other">Other Designs</button>
